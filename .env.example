# This portal's PUBLIC origin. It becomes the redirect URI registered on every realm created
# through it, so it must be the URL a browser actually reaches. Wrong value = sign-in fails
# with an unregistered-redirect error, and the realm has to be recreated.
#
# Leave it EMPTY in a Codespace. The portal derives the forwarded https address from
# CODESPACE_NAME at boot; a value here overrides that and will be wrong. See CODESPACES.md.
PORTAL_URL=http://localhost:8090

# Where visitors go to create a realm.
PROVISIONER_URL=http://localhost:8081

PORT=8090

# Signs the session cookie. Generated per boot when unset, which signs everyone out on every
# restart — set it to a long random string in production.
SESSION_SECRET=

# Set to "true" once served over https.
SECURE_COOKIES=

TENANTS_FILE=data/tenants.json
DEMO_APPS_FILE=data/demo-apps.json

# ORK origins the enclave runs on. Must match the realm's homeOrkUrl.
ORK_ORIGINS=https://ork1.tideprotocol.com
